# 로컬 실행용 예시. 복사해서 .env로 쓰거나 그대로 export 하세요.
# .env는 .gitignore에 있으니 커밋되지 않습니다.

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# scripts/get_token.py 실행 결과로 나오는 값
KAKAO_REFRESH_TOKEN=

# 연재 시작일 (KST 기준). 이 날이 0일차이고, 여기서부터 편성이 계산됩니다.
START_DATE=2026-01-01

# 트랙 편성 순서. 'kr,en'이면 하루씩 번갈아,
# 'kr,kr,en'이면 사흘 중 이틀은 한국 근대소설이 나갑니다.
TRACK_PATTERN=kr,en

# 1이면 실제로 보내지 않고 미리보기만 출력합니다.
DRY_RUN=1
