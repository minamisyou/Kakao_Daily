# 로컬 실행용 예시. 복사해서 .env로 쓰거나 그대로 export 하세요.
# .env는 .gitignore에 있으니 커밋되지 않습니다.

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# scripts/get_token.py 실행 결과로 나오는 값
KAKAO_REFRESH_TOKEN=

# 카카오 로그인 > 보안 > Client Secret이 '사용함'일 때만 채웁니다.
# '사용 안 함'이면 반드시 비워 두세요. 값을 넣으면 invalid_client가 납니다.
KAKAO_CLIENT_SECRET=

# 비워 두면 '나와의 채팅'으로 보냅니다. 친구(테스트 계정 등)에게 보내려면
# 그 uuid를 넣으세요 (여러 명이면 쉼표로). uuid는
#   python scripts/get_token.py --scope talk_message,friends
# 로 조회합니다. 비즈니스 전환 전에는 앱의 팀 멤버로 등록된 계정끼리만 됩니다.
KAKAO_RECEIVER_UUIDS=

# 연재 시작일 (KST 기준). 이 날이 코퍼스 맨 처음(첫 작품 1회차)이 나가는 날입니다.
# 코퍼스(data/segments.json)를 다시 빌드할 때마다 오늘 날짜로 맞춰 주세요 —
# 안 그러면 이미 지난 날짜만큼 큐를 건너뛴 지점(작품 중간)부터 시작해 버립니다.
START_DATE=2026-08-17

# 1이면 실제로 보내지 않고 미리보기만 출력합니다.
DRY_RUN=1
